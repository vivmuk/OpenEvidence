#!/usr/bin/env bash
# OpenEvidence pre-commit gate.
#
# Installed as .git/hooks/pre-commit (see scripts/install_hooks.sh).
#
# Runs on EVERY commit to this repo, including the ones made by the daily and
# weekly research jobs. Four jobs, in this order:
#
#   1. Auto-heal the research/benchmark data (merge duplicates, backfill ids,
#      normalise dates) and the site prose (em-dashes are banned by the design
#      doctrine).
#   2. Refresh the derived front-end data (signals, search index, scoreboard,
#      matrix diff, and the metrics/stat layer) from the healed sources.
#   3. Validate, and block the commit if the data is still broken.
#
# Order matters. The healers change research.json and benchmarks.json (dedupe
# merges records, so counts shrink), and every derived file is a projection of
# those sources. Generating before healing shipped counts that were two records
# ahead of the data; healing first and generating second keeps the derived
# layer a function of the committed data.
#
# Why this exists at all: the derived files are generated, and for a week they
# went stale while the daily and weekly jobs kept committing fresh source data.
# The site silently showed week-old signals. Enforcing at commit time covers
# every writer, not just the ones whose prompts we remembered to update.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

[ -f scripts/validate_data.py ] || exit 0

# --------------------------------------------------------------------------
# 1. Heal the source data first
# --------------------------------------------------------------------------
DATA_CHANGED=0
if git diff --cached --name-only | grep -qE '^data/(research|benchmarks)\.json$'; then
  DATA_CHANGED=1
fi

# Also heal when data files are dirty but not yet staged -- jobs often `git add -A`.
if [ "$DATA_CHANGED" -eq 0 ]; then
  if git status --porcelain -- data/research.json data/benchmarks.json | grep -q .; then
    DATA_CHANGED=1
  fi
fi

if [ "$DATA_CHANGED" -eq 1 ]; then
  # Auto-heal (best effort -- never block on the healer itself failing).
  if [ -f scripts/dedupe_data.py ]; then
    python3 scripts/dedupe_data.py --apply >/dev/null 2>&1 || true
  fi

  # Auto-heal copy tells: the research jobs write all the site prose, so
  # banned punctuation accumulates on its own.
  if [ -f scripts/fix_copy_tells.py ]; then
    python3 scripts/fix_copy_tells.py --apply >/dev/null 2>&1 || true
  fi

  # Re-stage anything the healers rewrote.
  git add data/research.json data/benchmarks.json 2>/dev/null || true
  git add '*.html' 'data/*.js' 2>/dev/null || true
  git add data/*.csv data/*.json 2>/dev/null || true
fi

# --------------------------------------------------------------------------
# 2. Regenerate the derived front-end data from the healed sources
# --------------------------------------------------------------------------
SRC_DATA="data/timeline.js data/competitors.js data/partners.js data/globalMatrix.js data/research.json data/benchmarks.json"
DERIVED="data/signals.js data/search-index.js data/scoreboard.js data/matrix-changes.js data/matrix-history.json"

if [ -f scripts/build_frontend_data.js ] && command -v node >/dev/null 2>&1; then
  SRC_CHANGED=0
  for f in $SRC_DATA; do
    if git diff --cached --name-only | grep -qx "$f" || git status --porcelain -- "$f" | grep -q .; then
      SRC_CHANGED=1
      break
    fi
  done

  if [ "$SRC_CHANGED" -eq 1 ]; then
    node scripts/build_frontend_data.js >/dev/null 2>&1 || true
    for f in $DERIVED; do
      [ -e "$f" ] && git add "$f" 2>/dev/null || true
    done
  fi
fi

# The semantic chat index (data/chatCorpus.js + data/chatVectors.js) is the one
# derived artefact that was NOT regenerated here, and it went stale for 9 days
# because of it: the daily tracker jobs committed fresh content while the
# corpus kept answering from Nov 8. The index is a projection of 35 source
# files, so it has to be rebuilt whenever any of them change.
#
# Rebuilding needs @xenova/transformers and the cached MiniLM weights, both
# of which are gitignored (node_modules/, .cache/) -- so a fresh clone cannot
# rebuild. That is a host-setup problem, not a data problem, so a missing
# dependency warns instead of blocking; a rebuild that actually runs and fails
# is a real error and blocks.
CHAT_SOURCES="data/abridgePartners.js data/abridgeProducts.js data/abridgeResearch.js data/abridgeSources.js data/abridgeTimeline.js data/benchmarks.js data/benchmarks.json data/competitors.js data/dxTimeline.js data/emergingTrends.js data/future.js data/globalMatrix.js data/globalRegions.js data/globalTimeline.js data/modelStack.js data/oeFeatures.js data/partners.js data/phaFreeTier.js data/phaPlayers.js data/phaResearch.js data/phaSources.js data/phaTimeline.js data/pharma.js data/products.js data/publications.js data/publishers.js data/regulatory.js data/research.json data/sctPublished.js data/sctResults.js data/signals.js data/sources.js data/timeline.js"

if [ -f scripts/build_chat_index.js ] && command -v node >/dev/null 2>&1; then
  CHAT_CHANGED=0
  for f in $CHAT_SOURCES; do
    [ -e "$f" ] || continue
    if git diff --cached --name-only | grep -qx "$f" || git status --porcelain -- "$f" | grep -q .; then
      CHAT_CHANGED=1
      break
    fi
  done

  if [ "$CHAT_CHANGED" -eq 1 ]; then
    if [ -d node_modules/@xenova/transformers ]; then
      if node scripts/build_chat_index.js >/tmp/oe-chatindex.out 2>&1; then
        git add data/chatCorpus.js data/chatVectors.js 2>/dev/null || true
      else
        echo "" >&2
        echo "COMMIT BLOCKED - the semantic chat index failed to rebuild." >&2
        tail -15 /tmp/oe-chatindex.out >&2
        echo "" >&2
        echo "The chat corpus would ship stale and answer from old content." >&2
        echo "Fix the build, then commit again." >&2
        exit 1
      fi
    else
      echo "WARNING: node_modules/@xenova/transformers is missing, so the" >&2
      echo "         semantic chat index could not be rebuilt and may be stale." >&2
      echo "         npm install @xenova/transformers  (in the repo root)" >&2
    fi
  fi
fi

# The stat cards and chart captions render from data/metrics.js, generated from
# data/metrics.csv. Regenerate on every commit so a search agent that only
# appends a CSV row still leaves the site's numbers current.
if [ -f scripts/sync_site.js ] && command -v node >/dev/null 2>&1; then
  if node scripts/sync_site.js >/dev/null 2>&1; then
    [ -e data/metrics.js ] && git add data/metrics.js 2>/dev/null || true
  else
    echo "WARNING: scripts/sync_site.js failed; data/metrics.js may be stale" >&2
  fi
fi

# --------------------------------------------------------------------------
# 3. Validate. Block on real errors.
# --------------------------------------------------------------------------
if [ "$DATA_CHANGED" -eq 1 ]; then
  if ! python3 scripts/validate_data.py --quiet >/tmp/oe-validate.out 2>&1; then
    echo "" >&2
    echo "┌──────────────────────────────────────────────────────────────┐" >&2
    echo "│  COMMIT BLOCKED - OpenEvidence data failed validation        │" >&2
    echo "└──────────────────────────────────────────────────────────────┘" >&2
    cat /tmp/oe-validate.out >&2
    echo "" >&2
    echo "Fix the data, then commit again." >&2
    echo "  python3 scripts/dedupe_data.py --apply   # auto-repair" >&2
    echo "  python3 scripts/validate_data.py         # inspect" >&2
    exit 1
  fi
fi

# --------------------------------------------------------------------------
# 5. Reject root-relative asset paths. Block on real errors.
# --------------------------------------------------------------------------
# The site has TWO deployments: Railway (primary) serves it from the domain
# root, GitHub Pages (fallback) serves it from the /OpenEvidence/ subpath.
# A root-relative path (/shared.css, /data/x.js, /timeline) resolves on one
# and 404s on the other -- which left the Pages fallback completely unstyled
# with dead nav links for weeks. Only relative paths work on both.
ROOTREL=""
for f in *.html; do
  [ -e "$f" ] || continue
  # Match src="/..." and href="/..." but not src="//cdn..." (protocol-relative)
  if grep -qE '(src|href)="/[^/]' "$f"; then
    ROOTREL="$ROOTREL $f"
  fi
done
if [ -n "$ROOTREL" ]; then
  echo "" >&2
  echo "┌──────────────────────────────────────────────────────────────┐" >&2
  echo "│  COMMIT BLOCKED - root-relative path in a page                │" >&2
  echo "└──────────────────────────────────────────────────────────────┘" >&2
  for f in $ROOTREL; do
    echo "  $f:" >&2
    grep -nE '(src|href)="/[^/]' "$f" | head -5 >&2
  done
  echo "" >&2
  echo "Use a relative path so the site works both at a domain root" >&2
  echo "(Railway) and under a subpath (GitHub Pages -> /OpenEvidence/)." >&2
  exit 1
fi

# --------------------------------------------------------------------------
# 6. Parse-check the data files. Block on real errors.
# --------------------------------------------------------------------------
# validate_data.py only covers research.json and benchmarks.json. A tracker
# data file with a syntax error (e.g. a missing trailing comma) passes that
# check, because nothing ever parses it as JavaScript -- and a file that
# fails to parse never defines its data variable, so the page renders an
# EMPTY section with no error anywhere. That shipped twice on global.html
# (globalTimeline.js, emergingTrends.js and globalMatrix.js, Oct 30 2026).
# node --check is the only thing that catches it.
JS_BAD=""
for f in data/*.js; do
  [ -e "$f" ] || continue
  if ! node --check "$f" >/tmp/oe-jscheck.out 2>&1; then
    JS_BAD="$JS_BAD $f"
  fi
done
if [ -n "$JS_BAD" ]; then
  echo "" >&2
  echo "┌──────────────────────────────────────────────────────────────┐" >&2
  echo "│  COMMIT BLOCKED - OpenEvidence data file has a syntax error   │" >&2
  echo "└──────────────────────────────────────────────────────────────────────┘" >&2
  for f in $JS_BAD; do echo "  $f" >&2; done
  echo "" >&2
  cat /tmp/oe-jscheck.out >&2
  echo "The file must be valid JavaScript. A file that does not parse never" >&2
  echo "defines its data variable, so the page renders an empty section." >&2
  exit 1
fi

exit 0
